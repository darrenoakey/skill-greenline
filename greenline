LAST_GREEN_REF = "refs/greenline/last-green"

# Three minutes is the performance target; ten minutes is the hard correctness
# deadline for the WHOLE release, starting before lock admission and ending only
# after publish. The target is a signal, never a reason to reject correct work.
# Tests patch these module values to exercise both boundaries quickly.
RELEASE_TARGET_SECONDS = 180
RELEASE_HARD_TIMEOUT_SECONDS = 600
RELEASE_TIMEOUT_REASON = "release exceeded its 600-second end-to-end deadline"

# Recovery begins only after a release has failed. It has its own clock so an
# expired success deadline can never prevent Greenline from restoring prod.
RECOVERY_HARD_TIMEOUT_SECONDS = 600
RECOVERY_TIMEOUT_REASON = "release recovery exceeded its separate 600-second deadline"

# Deploy and health get hard deadlines for the same reason: there is exactly one
# serialized gate, so a command that never returns blocks every agent on the
# machine forever. Also deliberately not user-configurable; tests patch these
# module values to exercise the boundaries without waiting for real minutes.
DEPLOY_HARD_TIMEOUT_SECONDS = 180
DEPLOY_TIMEOUT_REASON = "deploy exceeded the 3-minute hard timeout"
HEALTH_HARD_TIMEOUT_SECONDS = 5
HEALTH_TIMEOUT_REASON = "health probe exceeded the 5-second hard timeout"

SKILL_DIR = Path(__file__).resolve().parent
TEMPLATE_DIR = SKILL_DIR / "templates"
DOCTRINE_SRC = SKILL_DIR / "DOCTRINE.md"
SPEEDUP_CLI = SKILL_DIR / "greenline-speedup"
SPEEDUP_LAUNCH_OBSERVE_SECONDS = 2
PROCESS_GROUP_TERM_GRACE_SECONDS = 2
PROCESS_GROUP_KILL_GRACE_SECONDS = 2
PROCESS_PIPE_DRAIN_SECONDS = 2

VERBOSE = False
ACTIVE_RELEASE_DEADLINE: "ReleaseDeadline | None" = None


class ReleaseDeadlineExceeded(RuntimeError):
    pass


class ReleaseCancelled(RuntimeError):
    pass


@dataclass
class ReleaseDeadline:
    started: float
    hard_seconds: float
    reason: str

    @property
    def expires(self) -> float:
        return self.started + self.hard_seconds

    def remaining(self) -> float:
        return self.expires - time.monotonic()

    def require(self, stage: str) -> float:
        remaining = self.remaining()
        if remaining <= 0:
            raise ReleaseDeadlineExceeded(f"{self.reason} during {stage}")
        return remaining


@dataclass(frozen=True)
class CommandOutcome:
    returncode: int
    timeout_reason: str | None = None

    @property
    def timed_out(self) -> bool:
        return self.timeout_reason is not None


def release_remaining(stage: str) -> float | None:
    if ACTIVE_RELEASE_DEADLINE is None:
        return None
    return ACTIVE_RELEASE_DEADLINE.require(stage)


def operation_timeout(stage: str, stage_cap: float | None) -> tuple[float | None, bool]:
    remaining = release_remaining(stage)
    if remaining is None:
        return stage_cap, False
    if stage_cap is None or remaining < stage_cap:
        return remaining, True
    if stage_cap <= remaining:
        return stage_cap, False
    return remaining, True


@contextlib.contextmanager
def recovery_deadline():
    """Give safety recovery a fresh, explicit budget after release failure."""
    global ACTIVE_RELEASE_DEADLINE
    previous = ACTIVE_RELEASE_DEADLINE
    if previous is not None and previous.reason == RECOVERY_TIMEOUT_REASON:
        yield
        return
    ACTIVE_RELEASE_DEADLINE = ReleaseDeadline(
        time.monotonic(), RECOVERY_HARD_TIMEOUT_SECONDS, RECOVERY_TIMEOUT_REASON
    )
    try:
        yield
    finally:
        ACTIVE_RELEASE_DEADLINE = previous


# --------------------------------------------------------------------------
# output helpers
# --------------------------------------------------------------------------
def say(msg: str) -> None:
    print(msg)


def vsay(msg: str) -> None:
    if VERBOSE:
        print(msg)


def warn(msg: str) -> None:
    print(f"warning: {msg}", file=sys.stderr)


def die(msg: str, code: int = 1) -> NoReturn:
    print(f"error: {msg}", file=sys.stderr)
    raise SystemExit(code)


def utcnow() -> str:
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def utcstamp() -> str:
    return datetime.now(timezone.utc).isoformat()


# --------------------------------------------------------------------------
# git plumbing — always explicit -C, never rely on cwd
# --------------------------------------------------------------------------
def git(
    path: str | Path, *args: str, check: bool = True
) -> subprocess.CompletedProcess:
    cmd = ["git", "-c", "maintenance.auto=false", "-C", str(path), *args]
    vsay("$ " + " ".join(cmd))
    proc = run_argv(cmd, "git")
    if check and proc.returncode != 0:
        raise GitError(cmd, proc)
    return proc


class GitError(RuntimeError):
    def __init__(self, cmd, proc):
        self.cmd = cmd
        self.proc = proc
        super().__init__(
            f"git failed ({proc.returncode}): {' '.join(cmd)}\n{proc.stderr.strip()}"
        )


def git_out(path: str | Path, *args: str) -> str:
    return git(path, *args).stdout.strip()


def is_git_repo(path: str | Path) -> bool:
    return run_argv(
        ["git", "-C", str(path), "rev-parse", "--git-dir"], "git repository probe"
    ).returncode == 0


def git_common_dir(path: str | Path) -> Path:
    """Shared .git dir (resolves worktree gitdir to the real common dir)."""
    out = git_out(path, "rev-parse", "--path-format=absolute", "--git-common-dir")
    return Path(out).resolve()


def canonical_path(path: str | Path) -> Path:
    """The main checkout = parent of the git common dir."""
    return git_common_dir(path).parent.resolve()


def short(path: str | Path, ref: str) -> str:
    p = git(path, "rev-parse", "--short", ref, check=False)
    return p.stdout.strip() if p.returncode == 0 else "-"


def rev(path: str | Path, ref: str) -> str | None:
    p = git(path, "rev-parse", "--verify", "--quiet", ref, check=False)
    out = p.stdout.strip()
    return out or None


def current_branch(path: str | Path) -> str:
    return git_out(path, "rev-parse", "--abbrev-ref", "HEAD")


def worktree_is_dirty(path: str | Path) -> bool:
    return bool(git_out(path, "status", "--porcelain"))


def remote_exists(path: str | Path, name: str = "origin") -> bool:
    return name in git_out(path, "remote").split()


def list_worktrees(path: str | Path) -> list[dict]:
    """Parse `git worktree list --porcelain` into dicts."""
    out = git_out(path, "worktree", "list", "--porcelain")
    trees: list[dict] = []
    cur: dict = {}
    for line in out.splitlines():
        if not line.strip():
            if cur:
                trees.append(cur)
                cur = {}
            continue
        if line.startswith("worktree "):
            if cur:
                trees.append(cur)
            cur = {"worktree": line[len("worktree ") :]}
        elif line.startswith("branch "):
            cur["branch"] = line[len("branch ") :]
        elif line.startswith("HEAD "):
            cur["head"] = line[len("HEAD ") :]
    if cur:
        trees.append(cur)
    return trees


def worktree_for_branch(path: str | Path, branch: str) -> Path | None:
    ref = f"refs/heads/{branch}"
    for t in list_worktrees(path):
        if t.get("branch") == ref:
            return Path(t["worktree"]).resolve()
    return None


# --------------------------------------------------------------------------
# repo model
# --------------------------------------------------------------------------
@dataclass
class Repo:
    canonical: Path
    common_dir: Path
    config: dict

    @property
    def state_dir(self) -> Path:
        return self.common_dir / "greenline"

    @property
    def lock_path(self) -> Path:
        return self.state_dir / "lock"

    @property
    def journal_path(self) -> Path:
        return self.state_dir / "journal.jsonl"

    @property
    def status_path(self) -> Path:
        return self.state_dir / "status.json"

    @property
    def deployed_path(self) -> Path:
        return self.state_dir / "deployed"

    @property
    def allow_push_path(self) -> Path:
        return self.state_dir / "allow-push"

    @property
    def allow_main_path(self) -> Path:
        """Transient flag authorizing local updates to refs/heads/<main>.

        Written by the gate (PID inside) for the duration of a main-ref
        mutation. The reference-transaction hook refuses main updates unless
        this file exists AND its PID is still alive — so a crashed gate cannot
        leave main writable.
        """
        return self.state_dir / "allow-main"

    @property
    def pending_deploy_path(self) -> Path:
        """Legacy/interrupted SHA that reached main without deploy attestation."""
        return self.state_dir / "pending-deploy"

    @property
    def logs_dir(self) -> Path:
        return self.state_dir / "logs"

    @property
    def speedup_logs_dir(self) -> Path:
        return self.logs_dir / "speedup"

    @property
    def main_branch(self) -> str:
        return self.config.get("main_branch", "main")

    @property
    def worktree_base(self) -> Path:
        return Path(self.config["worktree_base"]).expanduser()

    @property
    def gate_path(self) -> Path:
        return self.worktree_base / "gate"

    @property
    def check_cmd(self) -> str:
        return self.config.get("check", "./run check")

    @property
    def deploy_cmd(self) -> str:
        return self.config.get("deploy", "./run deploy")

    @property
    def health_cmd(self) -> str:
        return self.config.get("health", "") or ""

    def ensure_state(self) -> None:
        self.state_dir.mkdir(parents=True, exist_ok=True)
        self.logs_dir.mkdir(parents=True, exist_ok=True)


def machine_config_path() -> Path:
    """Machine-local greenline config. Resolved per call so HOME can move."""
    return Path.home() / ".config" / "greenline" / "config.toml"


def machine_worktree_base(reponame: str) -> str | None:
    """Machine-local worktree location, keyed by canonical repo directory name.

    Where worktrees live is a property of the MACHINE, not of the repository,
    and it is not always a free choice. On macOS every executable that touches
    a USB/Thunderbolt volume needs its own TCC "removable volume" consent,
    keyed to that binary's identity. Go/Rust/Swift test binaries are rebuilt
    under a fresh random path on every run, so their consent can never be
    reused: the prompts never stop, and once one is refused the gate fails with
    a bare `Operation not permitted`. Such a repo has to be gated on internal
    storage even though its committed greenline.toml says otherwise -- and it
    cannot fix that by landing a commit, because landing a commit needs the
    very gate that is broken. So this override outranks greenline.toml:

        # ~/.config/greenline/config.toml   (machine-local, never committed)
        [worktree_base]
        agentd3 = "~/greenline-worktrees/agentd3"

    Missing file or missing key -> None, and greenline.toml stays authoritative.
    """
    path = machine_config_path()
    try:
        with path.open("rb") as fh:
            table = tomllib.load(fh).get("worktree_base", {})
    except FileNotFoundError:
        return None
    except (OSError, tomllib.TOMLDecodeError) as exc:
        die(f"machine config {path} is unreadable: {exc}", 2)
    if not isinstance(table, dict):
        die(f"machine config {path}: [worktree_base] must be a table", 2)
    value = table.get(reponame)
    return str(value) if value else None


def default_worktree_base(reponame: str) -> str:
    """Where a repo's greenline worktrees live when greenline.toml omits it.

    Prefers a large scratch volume when one is mounted (worktrees are full
    checkouts and multiply fast), and otherwise falls back to the home
    directory — so the tool works on a machine that has never heard of this
    author's external drive. A machine-local override in
    ~/.config/greenline/config.toml wins over both, and an explicit
    worktree_base in greenline.toml wins over this default.
    """
    scratch = Path("/Volumes/Gumby")
    if scratch.is_dir():
        return str(scratch / "worktrees" / "greenline" / reponame)
    return str(Path.home() / "greenline-worktrees" / reponame)


def load_repo(start: str | Path | None) -> Repo:
    start = Path(start).resolve() if start else Path.cwd()
    if not is_git_repo(start):
        die(f"{start} is not inside a git repository", 2)
    canon = canonical_path(start)
    common = git_common_dir(start)
    cfg_path = canon / "greenline.toml"
    if not cfg_path.exists():
        # Bootstrap submissions can legitimately add greenline.toml in their
        # feature worktree before it exists in the canonical checkout. Read
        # that committed candidate config so a non-"main" default branch and
        # custom gate path are honoured while the first branch is gated. Once
        # merged, the canonical config resumes being authoritative.
        worktree_root = Path(git_out(start, "rev-parse", "--show-toplevel")).resolve()
        candidate_cfg = worktree_root / "greenline.toml"
        if candidate_cfg.exists():
            cfg_path = candidate_cfg
    config: dict = {}
    if cfg_path.exists():
        with cfg_path.open("rb") as fh:
            config = tomllib.load(fh)
    override = machine_worktree_base(canon.name)
    if override:
        config["worktree_base"] = override
    elif "worktree_base" not in config:
        config["worktree_base"] = default_worktree_base(canon.name)
    return Repo(canonical=canon, common_dir=common, config=config)


# --------------------------------------------------------------------------
# lock + status
# --------------------------------------------------------------------------
class GateLock:
    """The original simple exclusive flock, bounded by the release clock."""

    def __init__(self, repo: Repo):
        self.repo = repo
        self.fh = None
        self.slow_gate: dict | None = None
        self.wait_started: float | None = None
        self.acquired_at: float | None = None
        self.phase_started_utc: str | None = None

    def __enter__(self):
        self.repo.ensure_state()
        self.fh = open(self.repo.lock_path, "w")
        self.wait_started = time.monotonic()
        acquired = False
        try:
            fcntl.flock(self.fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            acquired = True
        except OSError:
            pass
        if not acquired:
            self._wait_with_status()
        self.acquired_at = time.monotonic()
        self.phase_started_utc = None
        return self

    @property
    def queue_seconds(self) -> float:
        if self.wait_started is None or self.acquired_at is None:
            return 0.0
        return self.acquired_at - self.wait_started

    def _wait_with_status(self) -> None:
        say("gate busy — waiting for lock within the 600-second release deadline...")
        next_status = 0.0
        while True:
            remaining = release_remaining("gate lock admission")
            try:
                fcntl.flock(self.fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return
            except OSError:
                pass
            now = time.monotonic()
            if now >= next_status:
                self._print_holder()
                next_status = now + 30
            wait_for = 0.1 if remaining is None else min(0.1, remaining)
            threading.Event().wait(wait_for)

    def _print_holder(self) -> None:
        st = read_json(self.repo.status_path) or {}
        pid = st.get("pid", "?")
        branch = st.get("branch", "?")
        phase = st.get("phase", "?")
        started = st.get("started_utc")
        elapsed = ""
        if started:
            with contextlib.suppress(Exception):
                t0 = datetime.fromisoformat(started)
                elapsed = f" elapsed={int((datetime.now(timezone.utc) - t0).total_seconds())}s"
        say(f"  holder pid={pid} branch={branch} phase={phase}{elapsed}")

    def set_phase(
        self, phase: str, branch: str, started_utc: str | None = None
    ) -> None:
        st = read_json(self.repo.status_path) or {}
        self.phase_started_utc = (
            started_utc or self.phase_started_utc or utcstamp()
        )
        st["pid"] = os.getpid()
        st["branch"] = branch
        st["phase"] = phase
        st["started_utc"] = self.phase_started_utc
        write_json(self.repo.status_path, st)

    def clear_status(self) -> None:
        with contextlib.suppress(FileNotFoundError):
            self.repo.status_path.unlink()

    def require_optimization_after_release(
        self, branch: str, candidate: str, seconds: float, log_path: Path
    ) -> None:
        """Remember a slow-but-green gate so its agent is told after unlock."""
        self.slow_gate = {
            "branch": branch,
            "candidate": candidate,
            "seconds": seconds,
            "log_path": log_path,
        }

    def __exit__(self, *exc):
        if self.fh:
            with contextlib.suppress(Exception):
                fcntl.flock(self.fh, fcntl.LOCK_UN)
            self.fh.close()
        if self.slow_gate is not None:
            try:
                report_slow_gate(self.repo, **self.slow_gate)
            except Exception as report_exc:  # noqa: BLE001
                warn(
                    "slow-gate feedback reporting failed "
                    f"({type(report_exc).__name__}); gate remains green"
                )
        return False


def lock_is_held(repo: Repo) -> bool:
    """Non-blocking probe: True if some process holds the gate lock."""
    if not repo.lock_path.exists():
        return False
    with open(repo.lock_path, "w") as fh:
        try:
            fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            fcntl.flock(fh, fcntl.LOCK_UN)
            return False
        except OSError:
            return True


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


# --------------------------------------------------------------------------
# json + journal
# --------------------------------------------------------------------------
def read_json(path: Path) -> dict | None:
    if not path.exists():
        return None
    try:
        return json.loads(path.read_text())
    except (json.JSONDecodeError, OSError):
        return None


def write_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=2))
    tmp.replace(path)


def journal(repo: Repo, event: str, **fields) -> None:
    repo.ensure_state()
    entry = {"event": event, "ts": utcstamp(), **fields}
    with repo.journal_path.open("a") as fh:
        fh.write(json.dumps(entry) + "\n")


def journal_entries(repo: Repo) -> list[dict]:
    if not repo.journal_path.exists():
        return []
    out = []
    for line in repo.journal_path.read_text().splitlines():
        line = line.strip()
        if not line:
            continue
        with contextlib.suppress(json.JSONDecodeError):
            out.append(json.loads(line))
    return out


TERMINAL_EVENTS = {
    "complete",
    "deploy_failed",
    "rollback_failed",
    "adopt_failed",
    "abandoned",
    "recovered_rollback",
    "needs_fix_forward",
    "fail",
    "error",
}


def last_incomplete_gate(repo: Repo) -> dict | None:
    """Return the most recent 'start' event that has no terminal record after it."""
    entries = journal_entries(repo)
    start = None
    for e in entries:
        if e.get("event") == "start":
            start = e
            start["_phase_events"] = []
        elif start is not None:
            if e.get("event") in TERMINAL_EVENTS:
                start = None
            else:
                start["_phase_events"].append(e.get("event"))
                # later phase events carry the candidate SHA; fold it up
                if e.get("candidate") and not start.get("candidate"):
                    start["candidate"] = e["candidate"]
    return start


# --------------------------------------------------------------------------
# command runner (tee to log)
# --------------------------------------------------------------------------
def run_argv(cmd: list[str], stage: str) -> subprocess.CompletedProcess:
    """Run argv under the active release deadline and reap its process group."""
    release_remaining(stage)
    proc = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        start_new_session=True,
    )
    try:
        while True:
            remaining = release_remaining(stage)
            try:
                stdout, stderr = proc.communicate(
                    timeout=None if remaining is None else min(0.1, remaining)
                )
                break
            except subprocess.TimeoutExpired:
                release_remaining(stage)
    except BaseException as exc:
        _kill_process_group(proc)
        try:
            stdout, stderr = proc.communicate(timeout=PROCESS_PIPE_DRAIN_SECONDS)
        except subprocess.TimeoutExpired:
            for stream in (proc.stdout, proc.stderr):
                if stream is not None:
                    stream.close()
            with contextlib.suppress(subprocess.TimeoutExpired):
                proc.wait(timeout=PROCESS_PIPE_DRAIN_SECONDS)
            stdout, stderr = "", ""
        if not isinstance(exc, subprocess.TimeoutExpired):
            raise
        reason = (
            ACTIVE_RELEASE_DEADLINE.reason
            if ACTIVE_RELEASE_DEADLINE is not None
            else RELEASE_TIMEOUT_REASON
        )
        raise ReleaseDeadlineExceeded(
            f"{reason} during {stage}: {' '.join(cmd)}"
        ) from exc
    return subprocess.CompletedProcess(cmd, proc.returncode, stdout, stderr)


def _kill_process_group(proc: subprocess.Popen) -> None:
    """SIGTERM then SIGKILL the child's whole process group.

    A check spawns cargo/pytest/node children; killing only the shell leaves
    them running (and holding the gate's stdout pipe open forever). The child
    is a session/group leader (start_new_session=True), so its pid is the pgid.
    """
    # start_new_session=True makes the leader pid the pgid. Do not ask the
    # kernel for the leader's pgid here: it may exit on SIGTERM while a
    # TERM-ignoring descendant remains alive in the same group.
    pgid = proc.pid
    for sig, maximum_grace in (
        (signal.SIGTERM, PROCESS_GROUP_TERM_GRACE_SECONDS),
        (signal.SIGKILL, PROCESS_GROUP_KILL_GRACE_SECONDS),
    ):
        with contextlib.suppress(ProcessLookupError, PermissionError):
            os.killpg(pgid, sig)
        remaining = (
            ACTIVE_RELEASE_DEADLINE.remaining()
            if ACTIVE_RELEASE_DEADLINE is not None
            else maximum_grace
        )
        grace = max(0.001, min(maximum_grace, remaining))
        expires = time.monotonic() + grace
        while time.monotonic() < expires:
            try:
                os.killpg(pgid, 0)
            except ProcessLookupError:
                return
            except PermissionError:
                pass
            threading.Event().wait(min(0.02, max(0.0, expires - time.monotonic())))
    with contextlib.suppress(subprocess.TimeoutExpired):
        proc.wait(timeout=PROCESS_PIPE_DRAIN_SECONDS)


def run_shell_timed(
    cmd: str,
    cwd: Path,
    log_path: Path,
    timeout: float | None,
    timeout_reason: str,
) -> CommandOutcome:
    """Run a shell command, tee stdout+stderr to log file.

    Returns (exit code, timed_out). Strips CLAUDECODE from the child env
    (house gotcha: it can SIGSEGV CLIs). With a timeout, the child runs in its
    own session so the entire process group can be reaped on expiry.
    """
    env = os.environ.copy()
    env.pop("CLAUDECODE", None)
    log_path.parent.mkdir(parents=True, exist_ok=True)
    effective_timeout, deadline_limited = operation_timeout(timeout_reason, timeout)
    timed_out = False
    with log_path.open("a") as log:
        log.write(f"\n$ ({cwd}) {cmd}\n")
        log.flush()
        proc = subprocess.Popen(
            cmd,
            shell=True,
            cwd=str(cwd),
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
        if proc.stdout is None:
            raise RuntimeError(f"{timeout_reason}: child stdout pipe was not created")
        decoder = codecs.getincrementaldecoder(locale.getpreferredencoding(False))()
        selector = selectors.DefaultSelector()
        selector.register(proc.stdout, selectors.EVENT_READ)
        expires = (
            time.monotonic() + effective_timeout
            if effective_timeout is not None
            else None
        )

        def emit(data: bytes, final: bool = False) -> None:
            text = decoder.decode(data, final=final)
            log.write(text)
            log.flush()
            if VERBOSE:
                sys.stdout.write(text)
                sys.stdout.flush()

        try:
            while selector.get_map():
                remaining = None if expires is None else expires - time.monotonic()
                if remaining is not None and remaining <= 0:
                    if timed_out:
                        raise RuntimeError(
                            f"{timeout_reason}: process output did not close after group cleanup"
                        )
                    timed_out = True
                    log.write(
                        f"[timeout after {effective_timeout:.3f}s — killing process group]\n"
                    )
                    _kill_process_group(proc)
                    remaining = PROCESS_PIPE_DRAIN_SECONDS
                    expires = time.monotonic() + remaining
                events = selector.select(
                    0.1 if remaining is None else min(0.1, max(0.0, remaining))
                )
                for key, _ in events:
                    data = os.read(key.fd, 65536)
                    if data:
                        emit(data)
                    else:
                        emit(b"", final=True)
                        selector.unregister(key.fileobj)
                if timed_out and expires is not None and time.monotonic() >= expires:
                    raise RuntimeError(
                        f"{timeout_reason}: process output did not close after group cleanup"
                    )
            if proc.poll() is None:
                remaining = None if expires is None else max(0.0, expires - time.monotonic())
                proc.wait(timeout=remaining)
        except subprocess.TimeoutExpired:
            timed_out = True
            _kill_process_group(proc)
        except BaseException:
            _kill_process_group(proc)
            with contextlib.suppress(subprocess.TimeoutExpired):
                proc.wait(timeout=PROCESS_PIPE_DRAIN_SECONDS)
            raise
        finally:
            selector.close()
            proc.stdout.close()
        log.write(f"[exit {proc.returncode}]{' (TIMED OUT)' if timed_out else ''}\n")
    reason = (
        ACTIVE_RELEASE_DEADLINE.reason
        if timed_out and deadline_limited and ACTIVE_RELEASE_DEADLINE is not None
        else None
    )
    if timed_out and not deadline_limited:
        reason = timeout_reason
    return CommandOutcome(proc.returncode, reason)


def run_gate_deploy(repo: Repo, log_path: Path) -> CommandOutcome:
    """Run deploy under the aggregate release/recovery clock.

    Outside either workflow, retain the historical standalone deploy bound.
    """
    return run_shell_timed(
        repo.deploy_cmd,
        repo.canonical,
        log_path,
        None if ACTIVE_RELEASE_DEADLINE is not None else DEPLOY_HARD_TIMEOUT_SECONDS,
        DEPLOY_TIMEOUT_REASON,
    )


def run_gate_check(repo: Repo, cwd: Path, log_path: Path) -> tuple[CommandOutcome, float]:
    """Run change-impact validation under the aggregate release clock.

    Returns (exit code, timed_out, monotonic elapsed seconds). Crossing the
    soft budget is handled only after the whole gate succeeds.
    """
    started = time.monotonic()
    outcome = run_shell_timed(
        repo.check_cmd,
        cwd,
        log_path,
        None if ACTIVE_RELEASE_DEADLINE is not None else RELEASE_HARD_TIMEOUT_SECONDS,
        RELEASE_TIMEOUT_REASON,
    )
    return outcome, time.monotonic() - started


def check_timeout_banner(log_path: Path) -> None:
    say("")
    say("=" * 60)
    say(
        f"CHECK TIMED OUT — {RELEASE_TIMEOUT_REASON}. GATE FAILED."
    )
    say("The release has one 600-second deadline from invocation through publish.")
    say("Validate everything this change could break, chosen by change impact;")
    say("product growth must not make every release validate unrelated behavior.")
    say("Playbook: docs/DOCTRINE.md -> 'The check time budget'.")
    say("=" * 60)
    say(f"log: {log_path}")


def slow_gate_directive(seconds: float) -> str:
    """Describe the automatic response to a slow-but-green full release."""
    budget = f"{RELEASE_TARGET_SECONDS:.0f}"
    return (
        f"NOTE: this release was green, but its full queue-to-publish path took "
        f"{seconds:.1f}s against the {budget}s target. Greenline automatically "
        "starts a detached speed-up investigation. It must preserve validation "
        "of everything the change could break while selecting by change impact; "
        "it must not grow an exhaustive release suite with the product."
    )


def report_slow_gate(
    repo: Repo, branch: str, candidate: str, seconds: float, log_path: Path
) -> None:
    """Report and automatically investigate a slow-but-green full release."""
    journal(
        repo,
        "gate_slow",
        branch=branch,
        candidate=candidate,
        seconds=round(seconds, 6),
        target_seconds=RELEASE_TARGET_SECONDS,
    )
    header = (
        f"RELEASE TARGET EXCEEDED: {seconds:.3f}s "
        f"(target {RELEASE_TARGET_SECONDS:.0f}s; hard ceiling "
        f"{RELEASE_HARD_TIMEOUT_SECONDS:.0f}s)."
    )
    directive = slow_gate_directive(seconds)
    with log_path.open("a") as log:
        log.write(f"\n{header}\n{directive}\n")
    say("")
    say("=" * 60)
    say(header)
    say(directive)
    say("=" * 60)
    trigger_speedup_task(repo, branch, candidate, seconds, log_path)


def trigger_speedup_task(
    repo: Repo, branch: str, candidate: str, seconds: float, log_path: Path
) -> None:
    """Start the detached investigation and report only the outcome observed."""
    if not SPEEDUP_CLI.exists():
        journal(repo, "speedup_launch_failed", branch=branch, candidate=candidate)
        warn(f"greenline-speedup does not exist at {SPEEDUP_CLI}")
        return
    speedup_log = repo.speedup_logs_dir / f"{utcnow()}-{branch.replace('/', '_')}.log"
    speedup_log.parent.mkdir(parents=True, exist_ok=True)
    args = [
        sys.executable,
        str(SPEEDUP_CLI),
        "--repo",
        str(repo.canonical),
        "--branch",
        branch,
        "--candidate",
        candidate,
        "--seconds",
        f"{seconds:.3f}",
        "--budget",
        f"{RELEASE_TARGET_SECONDS:.3f}",
        "--hard-timeout",
        f"{RELEASE_HARD_TIMEOUT_SECONDS:.3f}",
        "--log",
        str(log_path),
    ]
    with speedup_log.open("w") as out:
        proc = subprocess.Popen(
            args,
            cwd=str(repo.canonical),
            stdout=out,
            stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
        )
        try:
            rc = proc.wait(timeout=SPEEDUP_LAUNCH_OBSERVE_SECONDS)
        except subprocess.TimeoutExpired:
            journal(
                repo,
                "speedup_launch_pending",
                branch=branch,
                candidate=candidate,
                pid=proc.pid,
                log=str(speedup_log),
            )
            say(f"  speed-up launcher still running; acceptance pending — log: {speedup_log}")
            return
    detail = log_tail(speedup_log, 10)
    if rc == 0:
        journal(
            repo,
            "speedup_triggered",
            branch=branch,
            candidate=candidate,
            seconds=round(seconds, 6),
            target_seconds=RELEASE_TARGET_SECONDS,
            log=str(speedup_log),
        )
        say(f"  speed-up investigation accepted — {detail.splitlines()[-1]}")
    else:
        journal(
            repo,
            "speedup_launch_failed",
            branch=branch,
            candidate=candidate,
            rc=rc,
            log=str(speedup_log),
        )
        warn(f"speed-up investigation launch failed (exit {rc}); log: {speedup_log}")


def log_tail(log_path: Path, n: int = 50) -> str:
    if not log_path.exists():
        return "(no log)"
    lines = log_path.read_text().splitlines()
    return "\n".join(lines[-n:])


# --------------------------------------------------------------------------
# gate worktree management
# --------------------------------------------------------------------------
def sync_submodules(path: str | Path) -> None:
    """Synchronize recursive submodules to the checked-out gitlinks."""
    git(path, "submodule", "sync", "--recursive")
    git(path, "submodule", "update", "--init", "--recursive", "--force")


def ensure_gate_worktree(repo: Repo) -> None:
    """Ensure the gate worktree exists, is healthy, and is reset to main tip."""
    gate = repo.gate_path
    main = repo.main_branch
    healthy = gate.exists() and is_git_repo(gate)
    if healthy:
        # confirm git knows about it
        known = any(
            Path(t["worktree"]).resolve() == gate.resolve()
            for t in list_worktrees(repo.canonical)
        )
        if not known:
            healthy = False
    if not healthy:
        git(repo.canonical, "worktree", "prune")
        if gate.exists():
            shutil.rmtree(gate, ignore_errors=True)
            git(repo.canonical, "worktree", "prune")
        gate.parent.mkdir(parents=True, exist_ok=True)
        git(repo.canonical, "worktree", "add", "--detach", str(gate), main)
    # self-heal a crash mid-squash: a conflicted index blocks checkout
    git(gate, "merge", "--abort", check=False)
    git(gate, "reset", "--hard", "HEAD", check=False)
    # hard reset + clean to main tip
    git(gate, "checkout", "--detach", main)
    git(gate, "reset", "--hard", main)
    # -fd, deliberately NOT -fdx: gitignored files (venvs, record/replay
    # caches) are the gate worktree's intended persistent state — they are
    # what keeps gate runs fast between submissions
    git(gate, "clean", "-fd")
    sync_submodules(gate)


# --------------------------------------------------------------------------
# health probe
# --------------------------------------------------------------------------
def health_probe(repo: Repo, log_path: Path) -> bool:
    """Is prod healthy? A probe that hangs past its hard cap is simply unhealthy.

    Recovery calls this while holding the gate lock, so an unbounded probe would
    wedge every submission behind it. With no health command configured the
    probe IS the deploy, so it gets the deploy cap instead of the 5-second one.
    """
    cmd = repo.health_cmd
    timeout = HEALTH_HARD_TIMEOUT_SECONDS
    reason = HEALTH_TIMEOUT_REASON
    if not cmd:
        cmd = repo.deploy_cmd
        timeout = DEPLOY_HARD_TIMEOUT_SECONDS
        reason = DEPLOY_TIMEOUT_REASON
    outcome = run_shell_timed(cmd, repo.canonical, log_path, timeout, reason)
    if outcome.timed_out:
        warn(outcome.timeout_reason + " — treating prod as unhealthy")
        return False
    return outcome.returncode == 0


# --------------------------------------------------------------------------
# preflight reconcile / recovery
# --------------------------------------------------------------------------
def preflight_base(repo: Repo, log_path: Path) -> None:
    """Incomplete-gate recovery + canonical clean/on-main checks.

    The shared prefix of the full preflight and of `adopt` (which must skip
    the drift check — drift is the point of adopt).
    """
    main = repo.main_branch

    # (a) recover from an incomplete gate
    inc = last_incomplete_gate(repo)
    if inc:
        with recovery_deadline():
            recover_incomplete(repo, inc, log_path)

    # (b) canonical must be clean and on main
    if worktree_is_dirty(repo.canonical):
        die(
            f"canonical checkout {repo.canonical} is DIRTY.\n"
            "greenline never modifies uncommitted files in the canonical checkout.\n"
            "Preserve or clear the changes yourself, then retry.",
            2,
        )
    if current_branch(repo.canonical) != main:
        git(repo.canonical, "checkout", main)


def preflight_reconcile(repo: Repo, log_path: Path) -> None:
    """Bring the repo to a known-good baseline before a gate run.

    Also used by `doctor --fix`. Handles crash recovery from the journal.
    """
    main = repo.main_branch
    preflight_base(repo, log_path)

    last_green = rev(repo.canonical, LAST_GREEN_REF)
    main_sha = rev(repo.canonical, main)

    # (c) drift between local main and last-green: NEVER discard commits.
    if last_green and main_sha and last_green != main_sha:
        lg_is_ancestor = (
            git(
                repo.canonical,
                "merge-base",
                "--is-ancestor",
                last_green,
                main_sha,
                check=False,
            ).returncode
            == 0
        )
        if lg_is_ancestor:
            die(
                f"local {main} ({main_sha[:8]}) is AHEAD of last-green ({last_green[:8]}).\n"
                "Commits reached main outside the gate (legacy workflow / hotfix).\n"
                "greenline will NOT touch them. Gate them in place with:\n"
                "  greenline adopt",
                2,
            )
        die(
            f"local {main} ({main_sha[:8]}) and last-green ({last_green[:8]}) have DIVERGED\n"
            "(or main is behind last-green). greenline will not modify main.\n"
            "Investigate manually — compare the two SHAs and reconcile by hand.",
            2,
        )
    if remote_exists(repo.canonical):
        git(repo.canonical, "fetch", "origin", main, check=False)
        origin = rev(repo.canonical, f"origin/{main}")
        deployed = read_deployed(repo)
        if origin and origin != main_sha:
            if deployed == origin:
                with allow_main_updates(repo):
                    git(repo.canonical, "merge", "--ff-only", origin)
                set_last_green(repo, origin)
            else:
                # is origin strictly ahead (ff possible)?
                mb = git(
                    repo.canonical,
                    "merge-base",
                    "--is-ancestor",
                    main_sha,
                    origin,
                    check=False,
                )
                if mb.returncode == 0:
                    # ff is lossless, but these commits never passed this gate:
                    # last-green must only ever mean gated+deployed.
                    with allow_main_updates(repo):
                        git(repo.canonical, "merge", "--ff-only", origin)
                    die(
                        f"origin/{main} had commits that never passed this gate; local "
                        f"{main} has been fast-forwarded to them.\n"
                        "Gate them in place with:\n"
                        "  greenline adopt",
                        2,
                    )

    # (d) gate worktree
    ensure_gate_worktree(repo)


def recover_incomplete(repo: Repo, inc: dict, log_path: Path) -> None:
    """Deterministically recover from a crashed gate run."""
    main = repo.main_branch
    M = inc.get("pre_main")
    C = inc.get("candidate")
    phases = set(inc.get("_phase_events", []))
    deployed = read_deployed(repo)
    origin = (
        rev(repo.canonical, f"origin/{main}") if remote_exists(repo.canonical) else None
    )

    say("greenline: recovering incomplete gate from journal...")

    # crashed adopt: main is NEVER reset (those commits are someone's work)
    if inc.get("adopt"):
        tip = rev(repo.canonical, main)
        last_green = rev(repo.canonical, LAST_GREEN_REF)
        if deployed == tip and health_probe(repo, log_path):
            if remote_exists(repo.canonical):
                publish(repo, tip)
            set_last_green(repo, tip)
            journal(repo, "complete", merged=tip, adopt=True, note="recovered_adopt")
        else:
            if last_green and last_green != tip:
                redeploy_detached(repo, last_green, log_path)
                write_deployed(repo, last_green)
            journal(repo, "adopt_failed", candidate=tip, note="recovered_adopt")
            prod_behind_banner(repo, tip, last_green)
        return

    # crash after push but before last-green update
    if origin and C and origin == C and rev(repo.canonical, LAST_GREEN_REF) != C:
        if health_probe(repo, log_path):
            set_last_green(repo, C)
            git(repo.canonical, "checkout", main, check=False)
            with allow_main_updates(repo):
                git(repo.canonical, "reset", "--hard", C)
            journal(repo, "complete", merged=C, note="recovered_after_push")
        else:
            if M:
                redeploy(repo, M, log_path)
                write_deployed(repo, M)
            journal(repo, "needs_fix_forward", candidate=C, pre_main=M)
            prod_behind_banner(repo, C, M)
        return

    if "ffed" in phases:
        # reached ff but crashed before terminal deploy record
        if deployed == C and health_probe(repo, log_path):
            if remote_exists(repo.canonical):
                publish(repo, C)
            set_last_green(repo, C)
            journal(repo, "complete", merged=C, note="recovered_ffed_healthy")
        else:
            if M:
                git(repo.canonical, "checkout", main, check=False)
                with allow_main_updates(repo):
                    git(repo.canonical, "reset", "--hard", M)
                redeploy(repo, M, log_path)
                write_deployed(repo, M)
            journal(repo, "recovered_rollback", pre_main=M, candidate=C)
        return

    if "checked" in phases:
        # nothing mutated outside the gate worktree
        journal(repo, "abandoned", candidate=C, note="checked_not_ffed")
        return

    # start with no checked/ffed: nothing to undo outside the gate
    journal(repo, "abandoned", candidate=C, note="start_only")


# --------------------------------------------------------------------------
# deployed / last-green helpers
# --------------------------------------------------------------------------
def read_deployed(repo: Repo) -> str | None:
    if repo.deployed_path.exists():
        return repo.deployed_path.read_text().strip() or None
    return None


def write_deployed(repo: Repo, sha: str) -> None:
    repo.ensure_state()
    repo.deployed_path.write_text(sha + "\n")


def read_pending_deploy(repo: Repo) -> str | None:
    if repo.pending_deploy_path.exists():
        return repo.pending_deploy_path.read_text().strip() or None
    return None


def write_pending_deploy(repo: Repo, sha: str | None) -> None:
    repo.ensure_state()
    if sha is None:
        with contextlib.suppress(FileNotFoundError):
            repo.pending_deploy_path.unlink()
        return
    repo.pending_deploy_path.write_text(sha + "\n")


def deploy_now(repo: Repo, sha: str, log_path: Path) -> CommandOutcome:
    """Run the repo's deploy command at the canonical checkout.

    Deploys whatever main currently points at. Clears any legacy/interrupted
    pending record on success so the state file never claims an
    undeployed main that is in fact live. Returns (exit code, timed_out); a
    deploy killed at the hard cap is a failed deploy like any other.
    """
    outcome = run_gate_deploy(repo, log_path)
    if outcome.returncode == 0 and not outcome.timed_out:
        write_deployed(repo, sha)
        write_pending_deploy(repo, None)
    return outcome


def flush_pending_deploy(
    repo: Repo, log_path: Path, lock=None, branch: str = ""
) -> bool:
    """Deploy a previously deferred, already-gated main tip.

    Called on the paths where THIS submission produced nothing deployable (merge
    conflict, failed check) but an earlier one in the burst was merged with its
    deploy deferred. Without this, a burst whose last member fails would leave
    prod permanently a commit behind — the deferred deploy would have no one
    left to perform it.

    Deploys the current main tip, which is exactly "the last successful thing we
    got up to". A no-op when nothing is pending, and skipped while more work is
    still queued (that later submission will deploy instead).
    """
    pending = read_pending_deploy(repo)
    if not pending:
        return False
    tip = rev(repo.canonical, repo.main_branch)
    if not tip:
        return False
    if lock is not None:
        lock.set_phase("deploying-pending", branch or "(deferred)")
    say(f"deploying deferred main {short(repo.canonical, tip)} ...")
    outcome = deploy_now(repo, tip, log_path)
    if outcome.returncode != 0 or outcome.timed_out:
        journal(
            repo,
            "pending_deploy_failed",
            pending=pending,
            tip=tip,
            rc=outcome.returncode,
            **({"reason": outcome.timeout_reason} if outcome.timed_out else {}),
        )
        warn(
            f"deferred deploy FAILED (exit {outcome.returncode}"
            f"{'; ' + outcome.timeout_reason if outcome.timed_out else ''}); "
            f"prod is behind main. log: {log_path}"
        )
        return False
    settle_green(repo, tip)
    journal(repo, "pending_deployed", tip=tip)
    say(f"deferred deploy OK — prod now at {short(repo.canonical, tip)}")
    return True


def set_last_green(repo: Repo, sha: str) -> None:
    git(repo.canonical, "update-ref", LAST_GREEN_REF, sha)


def settle_green(repo: Repo, sha: str) -> None:
    """Record a deployed sha as the new green: push it and move last-green.

    The deferred-deploy paths must do this themselves. The normal submit
    publishes right after its own deploy, but a submit KILLED between the
    ff-merge and that publish (a tool timeout, a lost terminal) leaves main
    ahead of origin with no one left to push it — and `deploy-pending` would
    then ship the code to prod while origin and last-green stayed behind, so a
    later rollback would target a sha that predates what is actually running.
    Both operations are idempotent, so calling this on an already-published tip
    is a no-op.
    """
    if remote_exists(repo.canonical):
        publish(repo, sha)
    set_last_green(repo, sha)


def redeploy(repo: Repo, sha: str, log_path: Path) -> None:
    """Restore prod to a known SHA at the canonical checkout."""
    git(repo.canonical, "checkout", repo.main_branch, check=False)
    with allow_main_updates(repo):
        git(repo.canonical, "reset", "--hard", sha)
    outcome = run_gate_deploy(repo, log_path)
    if outcome.returncode != 0 or outcome.timed_out:
        raise RuntimeError(
            f"rollback deploy failed rc={outcome.returncode} reason={outcome.timeout_reason}"
        )


def redeploy_detached(repo: Repo, sha: str, log_path: Path) -> None:
    """Deploy a SHA at the canonical checkout WITHOUT moving the main ref.

    Used by adopt failure paths, where main's commits must be preserved but
    prod must be restored to last-green.
    """
    git(repo.canonical, "checkout", "--detach", sha)
    try:
        outcome = run_gate_deploy(repo, log_path)
        if outcome.returncode != 0 or outcome.timed_out:
            raise RuntimeError(
                "detached rollback deploy failed "
                f"rc={outcome.returncode} reason={outcome.timeout_reason}"
            )
    finally:
        git(repo.canonical, "checkout", repo.main_branch)


def rollback_submit(repo: Repo, sha: str, log_path: Path) -> None:
    """Restore canonical main and prod under a separate recovery deadline."""
    with recovery_deadline():
        git(repo.canonical, "checkout", repo.main_branch, check=False)
        with allow_main_updates(repo):
            git(repo.canonical, "reset", "--hard", sha)
        sync_submodules(repo.canonical)
        redeploy(repo, sha, log_path)
        write_deployed(repo, sha)
        set_last_green(repo, sha)
        write_pending_deploy(repo, None)


def prod_behind_banner(repo: Repo, main_sha: str | None, prod_sha: str | None) -> None:
    say(
        "\n" + "=" * 60 + "\n"
        "PROD IS INTENTIONALLY BEHIND MAIN.\n"
        f"main is {short(repo.canonical, main_sha) if main_sha else '?'} but prod runs "
        f"{short(repo.canonical, prod_sha) if prod_sha else '?'}.\n"
        "Fix forward immediately: repair the code on main and re-run the gate\n"
        "(greenline adopt for in-place main commits).\n" + "=" * 60
    )


def prod_unknown_banner(repo: Repo, tip: str | None) -> None:
    """No known-good SHA to roll back to — say so loudly instead of pretending."""
    say(
        "\n" + "=" * 60 + "\n"
        "PROD STATE IS UNKNOWN.\n"
        f"The deploy of {short(repo.canonical, tip) if tip else '?'} failed and this "
        "repo has no previously\n"
        "deployed commit to restore — nothing was rolled back and main was not reset.\n"
        "FIX FORWARD: repair the deploy, then re-run `greenline adopt`.\n" + "=" * 60
    )


def publish(repo: Repo, sha: str) -> None:
    """Push main to origin using the transient allow-push flag."""
    repo.allow_push_path.write_text(utcstamp())
    try:
        git(repo.canonical, "push", "origin", repo.main_branch)
    finally:
        with contextlib.suppress(FileNotFoundError):
            repo.allow_push_path.unlink()


def exact_origin_main(repo: Repo) -> str | None:
    """Read the exact main ref from origin without trusting a tracking ref."""
    ref = f"refs/heads/{repo.main_branch}"
    proc = git(repo.canonical, "ls-remote", "--refs", "origin", ref, check=False)
    if proc.returncode != 0:
        raise GitError(["git", "ls-remote", "origin", ref], proc)
    matches = [line.split() for line in proc.stdout.splitlines() if line.strip()]
    exact = [fields[0] for fields in matches if len(fields) == 2 and fields[1] == ref]
    if len(exact) > 1:
        raise RuntimeError(f"origin returned duplicate values for {ref}")
    return exact[0] if exact else None


def reconcile_submit_publish_deadline(
    repo: Repo, candidate: str, pre_main: str, log_path: Path
) -> str:
    """Reconcile a push timeout from exact local, deployed, and remote refs."""
    with recovery_deadline():
        origin = exact_origin_main(repo)
        local = rev(repo.canonical, repo.main_branch)
        deployed = read_deployed(repo)
        if origin == candidate and local == candidate and deployed == candidate:
            set_last_green(repo, candidate)
            return "candidate_published"
        if origin == pre_main:
            rollback_submit(repo, pre_main, log_path)
            return "pre_release_restored"
        return (
            "diverged:"
            f"origin={origin or 'missing'},local={local or 'missing'},"
            f"deployed={deployed or 'missing'}"
        )


# --------------------------------------------------------------------------
# hooks — hard-lock main so only the gate can move it
# --------------------------------------------------------------------------
@contextlib.contextmanager
def allow_main_updates(repo: Repo):
    """Authorize local main-ref mutations for the duration of the block.

    The reference-transaction hook refuses updates to refs/heads/<main>
    unless `.git/greenline/allow-main` exists and names a still-alive PID.
    That makes `--no-verify` useless against this lock: reference-transaction
    cannot be skipped. A crashed gate cannot leave main writable because a
    dead PID fails the liveness check.
    """
    repo.ensure_state()
    path = repo.allow_main_path
    path.write_text(f"{os.getpid()}\n{utcstamp()}\n")
    try:
        yield
    finally:
        with contextlib.suppress(FileNotFoundError):
            path.unlink()


def pre_push_hook_block(repo: Repo) -> str:
    main = repo.main_branch
    allow = repo.allow_push_path
    return f"""{MARK_BEGIN}
# greenline: reject direct pushes to {main} unless the gate authorized it.
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/{main})
            if [ ! -f "{allow}" ]; then
                echo "greenline: direct push to {main} is forbidden." >&2
                echo "greenline: submit through the gate: greenline submit" >&2
                exit 1
            fi
            ;;
    esac
done
{MARK_END}
"""


def reference_transaction_hook_block(repo: Repo) -> str:
    """Hard lock: refuse any local update of refs/heads/<main> without allow-main.

    Cannot be bypassed with --no-verify. The gate writes allow-main (with its
    PID) around every intentional main-ref mutation.
    """
    main = repo.main_branch
    allow = repo.allow_main_path
    return f"""{MARK_BEGIN}
# greenline: refuse local updates to {main} unless the gate authorized them.
# reference-transaction cannot be skipped with --no-verify.
if [ "$1" != "prepared" ]; then
    # drain stdin on committed/aborted so the pipe never blocks
    cat >/dev/null
    exit 0
fi
while read -r old_value new_value ref_name; do
    case "$ref_name" in
        refs/heads/{main})
            # Git may report an unchanged ref while packing refs.
            zero_value="0000000000000000000000000000000000000000"
            if [ "$old_value" = "$new_value" ] && [ "$old_value" != "$zero_value" ]; then
                continue
            fi
            current_value="$(git rev-parse --verify "$ref_name" 2>/dev/null)"
            if [ "$old_value" = "$zero_value" ] && [ "$new_value" = "$current_value" ]; then
                continue
            fi
            if [ ! -f "{allow}" ]; then
                echo "greenline: direct update of {main} is forbidden." >&2
                echo "greenline: work in a worktree (greenline worktree <name>)," >&2
                echo "greenline: then submit through the gate: greenline submit" >&2
                exit 1
            fi
            # PID liveness: a crashed gate must not leave main writable.
            allow_pid="$(head -n1 "{allow}" 2>/dev/null | tr -d '[:space:]')"
            if [ -z "$allow_pid" ] || ! kill -0 "$allow_pid" 2>/dev/null; then
                echo "greenline: stale allow-main flag (pid ${{allow_pid:-empty}}) — refusing {main} update." >&2
                echo "greenline: work in a worktree, then: greenline submit" >&2
                exit 1
            fi
            ;;
    esac
done
{MARK_END}
"""


def pre_commit_hook_block(repo: Repo) -> str:
    """Friendly early reject when someone tries to commit on main.

    Soft layer: bypassable with --no-verify. The reference-transaction hook is
    the real lock; this just fails faster with a clearer message.
    """
    main = repo.main_branch
    return f"""{MARK_BEGIN}
# greenline: refuse commits while HEAD is on {main} (canonical checkout).
# Bypassable with --no-verify; the reference-transaction hook is the hard lock.
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
if [ "$branch" = "{main}" ]; then
    # Gate-authorized main updates still run commits? No — gate uses merge/reset.
    # But be safe: honour the same allow-main flag.
    common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
    allow="$common/greenline/allow-main"
    if [ ! -f "$allow" ]; then
        echo "greenline: commits on {main} are forbidden." >&2
        echo "greenline: start work with: greenline worktree <name>" >&2
        echo "greenline: then submit with: greenline submit" >&2
        exit 1
    fi
    allow_pid="$(head -n1 "$allow" 2>/dev/null | tr -d '[:space:]')"
    if [ -z "$allow_pid" ] || ! kill -0 "$allow_pid" 2>/dev/null; then
        echo "greenline: commits on {main} are forbidden (stale allow-main)." >&2
        echo "greenline: start work with: greenline worktree <name>" >&2
        exit 1
    fi
fi
{MARK_END}
"""


def _install_marked_hook(hooks_dir: Path, name: str, block: str) -> None:
    """Install or refresh a greenline-marked hook script idempotently."""
    hook = hooks_dir / name
    if hook.exists():
        text = hook.read_text()
        if MARK_BEGIN in text and MARK_END in text:
            pre = text.split(MARK_BEGIN)[0].rstrip("\n")
            post = text.split(MARK_END)[1] if MARK_END in text else ""
            text = pre + "\n\n" + block + post.lstrip("\n")
        else:
            if not text.startswith("#!"):
                text = "#!/usr/bin/env bash\n" + text
            text = text.rstrip("\n") + "\n\n" + block
    else:
        text = "#!/usr/bin/env bash\n\n" + block
    hook.write_text(text)
    hook.chmod(0o755)


def install_hooks(repo: Repo) -> None:
    """Install pre-push, reference-transaction, and pre-commit hard locks."""
    hooks = repo.common_dir / "hooks"
    hooks.mkdir(parents=True, exist_ok=True)
    _install_marked_hook(hooks, "pre-push", pre_push_hook_block(repo))
    _install_marked_hook(
        hooks, "reference-transaction", reference_transaction_hook_block(repo)
    )
    _install_marked_hook(hooks, "pre-commit", pre_commit_hook_block(repo))


# Back-compat alias used by older call sites / docs.
install_hook = install_hooks


# --------------------------------------------------------------------------
# templates
# --------------------------------------------------------------------------
def render_template(name: str, subs: dict) -> str:
    text = (TEMPLATE_DIR / name).read_text()
    for k, v in subs.items():
        text = text.replace("{" + k + "}", str(v))
    return text


def upsert_marked(path: Path, block: str, begin: str, end: str) -> None:
    block = f"{begin}\n{block.rstrip()}\n{end}\n"
    if path.exists():
        text = path.read_text()
        if begin in text and end in text:
            pre = text.split(begin)[0]
            post = text.split(end, 1)[1]
            text = pre.rstrip("\n") + "\n\n" + block + post.lstrip("\n")
        else:
            text = text.rstrip("\n") + "\n\n" + block
    else:
        text = block
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)


