# cli
# --------------------------------------------------------------------------
def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="greenline", description=__doc__.splitlines()[0])
    p.add_argument(
        "-v", "--verbose", action="store_true", help="verbose git/command output"
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    def add_repo(sp):
        sp.add_argument("--repo", help="path inside the target repo (default: cwd)")

    sp = sub.add_parser("setup", help="set this repo up with greenline")
    sp.add_argument(
        "--refresh-docs",
        action="store_true",
        help="re-render AGENTS section + docs from templates (overwrites repo customizations)",
    )
    add_repo(sp)
    sp.set_defaults(func=cmd_setup)

    sp = sub.add_parser("worktree", help="create a worktree branched from last-green")
    sp.add_argument("name")
    add_repo(sp)
    sp.set_defaults(func=cmd_worktree)

    sp = sub.add_parser("submit", help="submit a branch through the serialized gate")
    sp.add_argument("branch", nargs="?")
    add_repo(sp)
    sp.set_defaults(func=cmd_submit)

    sp = sub.add_parser(
        "adopt", help="gate the current main tip in place (out-of-gate commits)"
    )
    add_repo(sp)
    sp.set_defaults(func=cmd_adopt)

    sp = sub.add_parser("done", help="tear down a merged worktree")
    sp.add_argument("--force", action="store_true")
    add_repo(sp)
    sp.set_defaults(func=cmd_done)

    sp = sub.add_parser(
        "deploy-pending", help="recover a main that lacks deploy attestation"
    )
    add_repo(sp)
    sp.set_defaults(func=cmd_deploy_pending)

    sp = sub.add_parser("status", help="show gate + drift state (no lock)")
    add_repo(sp)
    sp.set_defaults(func=cmd_status)

    sp = sub.add_parser("doctor", help="check invariants; --fix reconciles")
    sp.add_argument("--fix", action="store_true")
    add_repo(sp)
    sp.set_defaults(func=cmd_doctor)
    return p


def main(argv: list[str] | None = None) -> int:
    global ACTIVE_RELEASE_DEADLINE, VERBOSE
    invoked = time.monotonic()
    parser = build_parser()
    args = parser.parse_args(argv)
    VERBOSE = args.verbose
    release_command = args.cmd in {"submit", "adopt", "deploy-pending"}
    previous_sigterm = None
    if release_command:
        ACTIVE_RELEASE_DEADLINE = ReleaseDeadline(
            invoked, RELEASE_HARD_TIMEOUT_SECONDS, RELEASE_TIMEOUT_REASON
        )
        if threading.current_thread() is threading.main_thread():
            previous_sigterm = signal.getsignal(signal.SIGTERM)

            def cancel_release(_signum, _frame) -> NoReturn:
                raise ReleaseCancelled("release cancelled by SIGTERM")

            signal.signal(signal.SIGTERM, cancel_release)
    try:
        return args.func(args)
    except ReleaseDeadlineExceeded as exc:
        warn(f"RELEASE DEADLINE FAILED — {exc}")
        return 1
    except ReleaseCancelled as exc:
        warn(f"RELEASE CANCELLED — {exc}")
        return 1
    except GitError as e:
        die(str(e), 2)
    except SystemExit:
        raise
    except KeyboardInterrupt:
        die("interrupted", 1)
    finally:
        if previous_sigterm is not None:
            signal.signal(signal.SIGTERM, previous_sigterm)
        ACTIVE_RELEASE_DEADLINE = None


if __name__ == "__main__":
    signal.signal(signal.SIGPIPE, signal.SIG_DFL) if hasattr(
        signal, "SIGPIPE"
    ) else None
    sys.exit(main())
