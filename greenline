def cmd_setup(args) -> int:
    start = Path(args.repo).resolve() if args.repo else Path.cwd()
    if not is_git_repo(start):
        die(f"{start} is not a git repository", 2)
    canon = canonical_path(start)
    reponame = canon.name
    main = "main"
    if not rev(canon, main):
        # fall back to whatever the current branch is — loudly, because baking a
        # feature-branch name into greenline.toml as main_branch is never wanted
        main = current_branch(canon)
        warn(f"no 'main' branch found — using current branch {main!r} as main_branch")

    cfg_path = canon / "greenline.toml"
    wt_base = default_worktree_base(reponame)
    if not cfg_path.exists():
        content = render_template(
            "greenline.toml.template",
            {
                "contract_version": CONTRACT_VERSION,
                "main_branch": main,
                "reponame": reponame,
                "service": reponame,
                "worktree_base": wt_base,
            },
        )
        cfg_path.write_text(content)
        say(f"wrote {cfg_path}")
    else:
        say("greenline.toml exists — leaving it")

    repo = load_repo(canon)
    repo.ensure_state()

    # contract check (best-effort)
    run_script = canon / "run"
    if not run_script.exists():
        warn(f"no ./run script found in {canon} — the gate contract needs one")
    else:
        script_text = run_script.read_text() if run_script.is_file() else ""
        for sub in ("check", "deploy"):
            if sub not in script_text:
                warn(f"./run does not appear to implement '{sub}' yet")

    # last-green ref
    if not rev(canon, LAST_GREEN_REF):
        tip = rev(canon, main)
        if tip:
            set_last_green(repo, tip)
            say(f"set {LAST_GREEN_REF} -> {short(canon, tip)}")

    # gate worktree
    ensure_gate_worktree(repo)
    say(f"gate worktree at {repo.gate_path}")

    # hooks (pre-push + reference-transaction hard lock + pre-commit)
    install_hooks(repo)
    say(f"installed main-lock hooks in {repo.common_dir / 'hooks'}")

    # doctrine + docs + agents — never clobber existing copies: repos
    # customize these (repo-specific pointers into their own code), and a
    # re-run of setup must not silently revert that. Refresh explicitly
    # with --refresh-docs after a template upgrade.
    subs = {
        "reponame": reponame,
        "service": repo.config.get("service", reponame),
        "check": repo.check_cmd,
        "deploy": repo.deploy_cmd,
        "main_branch": main,
        "worktree_base": str(repo.worktree_base),
    }
    doctrine_dst = canon / "docs" / "DOCTRINE.md"
    if args.refresh_docs or not doctrine_dst.exists():
        install_doctrine(repo)

    agents_path = canon / "AGENTS.md"
    if args.refresh_docs or MD_BEGIN not in (
        agents_path.read_text() if agents_path.exists() else ""
    ):
        agents_block = render_template("AGENTS-section.md.template", subs)
        upsert_marked(agents_path, agents_block, MD_BEGIN, MD_END)
        say(f"updated {agents_path}")
    else:
        say(
            "AGENTS.md greenline section exists — leaving it (--refresh-docs to re-render)"
        )

    docs_path = canon / "docs" / "greenline.md"
    if args.refresh_docs or not docs_path.exists():
        docs_block = render_template("docs-greenline.md.template", subs)
        docs_path.parent.mkdir(exist_ok=True)
        docs_path.write_text(docs_block)
        say(f"wrote {docs_path}")
    else:
        say("docs/greenline.md exists — leaving it (--refresh-docs to re-render)")

    # land the scaffolding ourselves: the hooks we just installed make a
    # manual `git commit` on main impossible, so setup must commit its own
    # files under the same allow-main authorization the gate uses.
    pre_main = rev(canon, main)
    new_tip = commit_scaffolding(repo, main)
    if new_tip:
        say(f"committed greenline scaffolding on {main} ({short(canon, new_tip)})")
        if rev(canon, LAST_GREEN_REF) == pre_main:
            # last-green tracked the pre-scaffolding tip: keep main == last-green
            # so worktrees branch off a base that already carries greenline.toml.
            set_last_green(repo, new_tip)
            say(f"moved {LAST_GREEN_REF} -> {short(canon, new_tip)}")
        else:
            warn(
                f"{main} is now ahead of {LAST_GREEN_REF} — gate the scaffolding "
                "commit with: greenline adopt"
            )

    say("")
    _doctor_report(repo)
    say("")
    say("next steps:")
    say("  greenline worktree <name>   # start work")
    return 0


# Exactly the files setup itself writes. Nothing else is ever staged, so
# unrelated dirt in the canonical checkout stays uncommitted (and doctor keeps
# reporting it).
SCAFFOLD_PATHS = (
    "greenline.toml",
    "AGENTS.md",
    "docs/greenline.md",
    "docs/DOCTRINE.md",
)
SCAFFOLD_COMMIT_MSG = "Add greenline gate config"


def scaffolding_dirty(canon: Path) -> list[str]:
    """Which of SCAFFOLD_PATHS are modified or untracked in the canonical."""
    dirty = []
    for rel in SCAFFOLD_PATHS:
        if not (canon / rel).exists():
            continue
        if git_out(canon, "status", "--porcelain", "--untracked-files=all", "--", rel):
            dirty.append(rel)
    return dirty


def commit_scaffolding(repo: Repo, main: str) -> str | None:
    """Commit greenline's own scaffolding on main; return the new tip, or None.

    setup installs hard main-lock hooks and THEN writes greenline.toml,
    AGENTS.md and the docs — so telling the user to `git commit` them is
    telling them to do something the just-installed pre-commit hook refuses.
    We hold allow-main (same flag as the gate) for exactly this one commit and
    drop it in a finally block, so a crash can never leave main writable.
    Idempotent: nothing dirty among those paths means no commit.
    """
    canon = repo.canonical
    if current_branch(canon) != main:
        return None
    dirty = scaffolding_dirty(canon)
    if not dirty:
        return None
    unborn = rev(canon, "HEAD") is None
    with allow_main_updates(repo):
        git(canon, "add", "--", *dirty)
        if unborn:
            git(canon, "commit", "-m", SCAFFOLD_COMMIT_MSG)
        else:
            # pathspec commit: whatever else happens to be staged in the
            # canonical index is left alone.
            git(canon, "commit", "-m", SCAFFOLD_COMMIT_MSG, "--", *dirty)
    return rev(canon, main)


def install_doctrine(repo: Repo) -> None:
    if DOCTRINE_SRC.exists():
        docs = repo.canonical / "docs"
        docs.mkdir(exist_ok=True)
        dst = docs / "DOCTRINE.md"
        shutil.copyfile(DOCTRINE_SRC, dst)
        say(f"installed {dst}")


def cmd_worktree(args) -> int:
    repo = load_repo(args.repo)
    name = args.name
    branch = f"gl/{name}"
    target = repo.worktree_base / name
    if target.exists():
        die(f"worktree path already exists: {target}")
    if rev(repo.canonical, f"refs/heads/{branch}"):
        die(f"branch {branch} already exists")
    with GateLock(repo):
        base = rev(repo.canonical, LAST_GREEN_REF) or rev(
            repo.canonical, repo.main_branch
        )
        if not base:
            die("no last-green ref and no main tip to branch from", 2)
        target.parent.mkdir(parents=True, exist_ok=True)
        git(repo.canonical, "worktree", "add", "-b", branch, str(target), base)
    say(str(target))
    return 0


def cmd_submit(args) -> int:
    repo = load_repo(args.repo)
    main = repo.main_branch
    advanced = False
    publish_attempted = False
    pre_main: str | None = None
    candidate: str | None = None
    release_started = (
        ACTIVE_RELEASE_DEADLINE.started
        if ACTIVE_RELEASE_DEADLINE is not None
        else time.monotonic()
    )

    branch = args.branch
    if not branch:
        branch = current_branch(Path(args.repo).resolve() if args.repo else Path.cwd())
    if branch in (main, "HEAD"):
        die(f"cannot submit '{branch}' (that is the main branch or a detached HEAD)")

    if not rev(repo.canonical, f"refs/heads/{branch}"):
        die(f"branch {branch} does not exist")

    their_wt = worktree_for_branch(repo.canonical, branch)
    if their_wt and worktree_is_dirty(their_wt):
        die(f"worktree {their_wt} has uncommitted changes — commit or stash them first")

    base_ref = rev(repo.canonical, LAST_GREEN_REF) or rev(repo.canonical, main)
    mb = git_out(repo.canonical, "merge-base", branch, base_ref)
    if mb == rev(repo.canonical, branch):
        die(
            f"branch {branch} has no commits ahead of last-green/main (empty candidate)"
        )

    log_path = repo.logs_dir / f"{utcnow()}-{branch.replace('/', '_')}.log"
    lock = GateLock(repo)
    with lock:
        try:
            lock.set_phase("preflight", branch)
            preflight_reconcile(repo, log_path)

            M = rev(repo.canonical, main)
            pre_main = M
            src = rev(repo.canonical, branch)
            journal(repo, "start", branch=branch, candidate_src_sha=src, pre_main=M)

            gate = repo.gate_path
            # merge --squash
            lock.set_phase("merging", branch)
            mp = git(gate, "merge", "--squash", branch, check=False)
            if mp.returncode != 0:
                conflicts = git_out(gate, "diff", "--name-only", "--diff-filter=U")
                git(gate, "merge", "--abort", check=False)
                git(gate, "reset", "--hard", main)
                git(gate, "clean", "-fd")
                journal(repo, "fail", stage="merge", branch=branch, conflicts=conflicts)
                flush_pending_deploy(repo, log_path, lock, branch)
                say("MERGE CONFLICT — candidate does not apply on top of main.")
                say("conflicting files:")
                for f in conflicts.splitlines():
                    say(f"  {f}")
                wt = their_wt or "<your worktree>"
                say("")
                say("rebase your worktree on latest main and resolve, then resubmit:")
                say(f"  git -C {wt} fetch && git -C {wt} rebase {main}")
                return 1

            # ensure the squash produced a real diff
            if not git_out(gate, "diff", "--cached", "--name-only"):
                git(gate, "reset", "--hard", main)
                git(gate, "clean", "-fd")
                journal(repo, "fail", stage="empty", branch=branch)
                die("candidate produces no changes against main (empty diff)")

            # build commit message
            subjects = git_out(
                repo.canonical, "log", "--format=%s", f"{M}..{branch}"
            ).splitlines()
            tip_subject = subjects[0] if subjects else branch
            body = "\n".join(f"- {s}" for s in subjects)
            msg = f"{branch}: {tip_subject}\n\n{body}\n\nVia: greenline gate"
            git(gate, "commit", "-m", msg)
            C = rev(gate, "HEAD")
            candidate = C
            sync_submodules(gate)

            # check
            lock.set_phase("checking", branch)
            say(f"checking candidate {short(gate, 'HEAD')} ...")
            check_outcome, check_seconds = run_gate_check(repo, gate, log_path)
            if check_outcome.returncode != 0 or check_outcome.timed_out:
                journal(
                    repo,
                    "fail",
                    stage="check",
                    branch=branch,
                    candidate=C,
                    rc=check_outcome.returncode,
                    **(
                        {"reason": check_outcome.timeout_reason}
                        if check_outcome.timed_out
                        else {}
                    ),
                )
                cleanup_context = (
                    recovery_deadline()
                    if check_outcome.timed_out
                    else contextlib.nullcontext()
                )
                with cleanup_context:
                    git(gate, "reset", "--hard", main)
                    git(gate, "clean", "-fd")
                # This candidate never reached main, but an EARLIER one may have
                # been merged with its deploy deferred behind us. We are the last
                # of the burst, so ship that known-good main now instead of
                # leaving prod behind a commit nobody will come back for.
                if check_outcome.timed_out:
                    check_timeout_banner(log_path)
                    say("main is untouched; branch preserved.")
                else:
                    say(
                        "CHECK FAILED "
                        f"(exit {check_outcome.returncode}). main is untouched; "
                        "branch preserved."
                    )
                    say(f"log: {log_path}")
                say("--- last 50 lines ---")
                say(log_tail(log_path, 50))
                return 1
            journal(repo, "checked", candidate=C)

            # advance canonical main
            lock.set_phase("advancing", branch)
            with allow_main_updates(repo):
                git(repo.canonical, "merge", "--ff-only", C)
            advanced = True
            sync_submodules(repo.canonical)
            journal(repo, "ffed", candidate=C, pre_main=M)

            # Every successful release deploys this exact candidate. The legacy
            # coalesce_deploys config key is accepted but intentionally ignored.
            lock.set_phase("deploying", branch)
            say("deploying to prod ...")
            deploy_started = time.monotonic()
            deploy_outcome = deploy_now(repo, C, log_path)
            deploy_seconds = time.monotonic() - deploy_started
            if deploy_outcome.returncode != 0 or deploy_outcome.timed_out:
                if deploy_outcome.timed_out:
                    say(f"DEPLOY TIMED OUT — {deploy_outcome.timeout_reason}.")
                say(
                    "DEPLOY FAILED "
                    f"(exit {deploy_outcome.returncode}) — rolling back to "
                    f"{M[:8]}"
                )
                try:
                    rollback_submit(repo, M, log_path)
                except Exception as rollback_exc:  # noqa: BLE001
                    journal(
                        repo,
                        "rollback_failed",
                        candidate=C,
                        pre_main=M,
                        rc=deploy_outcome.returncode,
                        rollback_error=repr(rollback_exc),
                    )
                    say(f"ROLLBACK FAILED — {rollback_exc}")
                    say(f"log: {log_path}")
                    return 1
                advanced = False
                journal(
                    repo,
                    "deploy_failed",
                    candidate=C,
                    pre_main=M,
                    rc=deploy_outcome.returncode,
                    **(
                        {"reason": deploy_outcome.timeout_reason}
                        if deploy_outcome.timed_out
                        else {}
                    ),
                )
                say(f"prod restored to {M[:8]}. branch preserved.")
                say(f"log: {log_path}")
                say(log_tail(log_path, 50))
                return 1

            # publish
            lock.set_phase("publishing", branch)
            release_remaining("publish")
            publish_started = time.monotonic()
            if remote_exists(repo.canonical):
                publish_attempted = True
                publish(repo, C)
            set_last_green(repo, C)
            publish_seconds = time.monotonic() - publish_started
            total_seconds = time.monotonic() - release_started
            timings = {
                "queue_seconds": round(lock.queue_seconds, 6),
                "check_seconds": round(check_seconds, 6),
                "deploy_seconds": round(deploy_seconds, 6),
                "publish_seconds": round(publish_seconds, 6),
                "total_seconds": round(total_seconds, 6),
            }
            journal(repo, "complete", merged=C, branch=branch, **timings)
            if total_seconds > RELEASE_TARGET_SECONDS:
                lock.require_optimization_after_release(
                    branch, C, total_seconds, log_path
                )

            say("")
            say("GATE PASSED")
            say(f"  branch   : {branch}")
            say(f"  merged   : {short(repo.canonical, C)}")
            say("  deployed : ok")
            say(
                "  timings  : "
                f"queue={timings['queue_seconds']:.3f}s "
                f"check={timings['check_seconds']:.3f}s "
                f"deploy={timings['deploy_seconds']:.3f}s "
                f"publish={timings['publish_seconds']:.3f}s "
                f"total={timings['total_seconds']:.3f}s"
            )
            say(f"  log      : {log_path}")
            say(f"  next     : greenline done   # from {their_wt or 'your worktree'}")
            return 0
        except (ReleaseDeadlineExceeded, ReleaseCancelled) as exc:
            rollback_error = None
            reconciliation = None
            if advanced and pre_main:
                try:
                    if publish_attempted and candidate:
                        reconciliation = reconcile_submit_publish_deadline(
                            repo, candidate, pre_main, log_path
                        )
                        advanced = reconciliation != "pre_release_restored"
                    else:
                        rollback_submit(repo, pre_main, log_path)
                        advanced = False
                except Exception as rollback_exc:  # noqa: BLE001
                    rollback_error = repr(rollback_exc)
            journal(
                repo,
                "fail",
                stage=(
                    "release_deadline"
                    if isinstance(exc, ReleaseDeadlineExceeded)
                    else "release_cancelled"
                ),
                branch=branch,
                candidate=candidate,
                reason=str(exc),
                **({"reconciliation": reconciliation} if reconciliation else {}),
                **({"rollback_error": rollback_error} if rollback_error else {}),
            )
            say(f"RELEASE FAILED — {exc}")
            say(
                "release failed; recovery ran separately and is not a release success"
            )
            if rollback_error:
                say(f"ROLLBACK FAILED — {rollback_error}")
            elif reconciliation == "candidate_published":
                say(
                    "origin, local main, and deployed attest the candidate; "
                    "last-green was reconciled without rewinding origin."
                )
            elif reconciliation and reconciliation.startswith("diverged:"):
                say(
                    "publish outcome diverged; no ref or deployed state was "
                    f"rewound ({reconciliation})."
                )
            else:
                say("main and prod restored; branch preserved.")
            return 1
        except SystemExit:
            raise
        except Exception as exc:  # noqa: BLE001
            journal(repo, "error", exc=repr(exc), branch=branch)
            raise
        finally:
            lock.clear_status()


def cmd_adopt(args) -> int:
    """Gate the CURRENT main tip in place (commits that reached main outside
    the gate: legacy-workflow sessions, hotfixes). Never resets main."""
    repo = load_repo(args.repo)
    main = repo.main_branch
    log_path = repo.logs_dir / f"{utcnow()}-adopt.log"
    lock = GateLock(repo)
    deployed_before: str | None = None
    tip: str | None = None
    release_started = (
        ACTIVE_RELEASE_DEADLINE.started
        if ACTIVE_RELEASE_DEADLINE is not None
        else time.monotonic()
    )
    with lock:
        try:
            lock.set_phase("preflight", "adopt")
            # incomplete-gate recovery + clean/on-main checks; NO drift check —
            # drift is the point of adopt.
            preflight_base(repo, log_path)

            tip = rev(repo.canonical, main)
            last_green = rev(repo.canonical, LAST_GREEN_REF)
            deployed = read_deployed(repo)
            deployed_before = deployed
            if not tip:
                die(f"no {main} branch to adopt", 2)
            if tip == last_green and deployed == tip:
                say("main already == last-green; nothing to adopt")
                return 0
            # BOOTSTRAP: main == last-green (setup just committed the
            # scaffolding) but prod has never been deployed by a gate, so
            # `deployed` is missing or stale. Direct pushes to main are
            # hook-blocked by design, which used to leave no way at all to
            # deploy/publish/initialize a freshly set-up repo. Adopt is that
            # path: full check + deploy + publish, no ref mutation needed.

            ensure_gate_worktree(repo)
            journal(
                repo,
                "start",
                adopt=True,
                branch="adopt",
                candidate=tip,
                pre_main=last_green,
            )

            # check at the main tip in the gate worktree
            lock.set_phase("checking", "adopt")
            say(f"checking main tip {short(repo.canonical, tip)} ...")
            check_outcome, check_seconds = run_gate_check(repo, repo.gate_path, log_path)
            if check_outcome.returncode != 0 or check_outcome.timed_out:
                journal(
                    repo,
                    "adopt_failed",
                    stage="check",
                    candidate=tip,
                    rc=check_outcome.returncode,
                    **(
                        {"reason": check_outcome.timeout_reason}
                        if check_outcome.timed_out
                        else {}
                    ),
                )
                if check_outcome.timed_out:
                    check_timeout_banner(log_path)
                    say("main untouched; prod untouched.")
                else:
                    say(
                        f"CHECK FAILED (exit {check_outcome.returncode}). "
                        "main untouched; prod untouched."
                    )
                    say(f"log: {log_path}")
                say(
                    "Fix the code on main (or revert the offending commits), then re-run"
                    " greenline adopt."
                )
                say(log_tail(log_path, 50))
                return 1
            journal(repo, "checked", candidate=tip)

            # deploy at canonical (already at the main tip)
            lock.set_phase("deploying", "adopt")
            say("deploying to prod ...")
            deploy_started = time.monotonic()
            deploy_outcome = run_gate_deploy(repo, log_path)
            deploy_seconds = time.monotonic() - deploy_started
            if deploy_outcome.returncode != 0 or deploy_outcome.timed_out:
                if deploy_outcome.timed_out:
                    say(f"DEPLOY TIMED OUT — {deploy_outcome.timeout_reason}.")
                # Prefer the SHA prod actually ran (deployed) over last-green:
                # after setup --refresh-docs, last-green == tip while deployed
                # still names the known-good build.
                restore = next(
                    (s for s in (deployed, last_green) if s and s != tip), None
                )
                if restore:
                    say(
                        f"DEPLOY FAILED (exit {deploy_outcome.returncode}) — "
                        "restoring prod to last-green"
                        " (main is NOT reset; those commits are preserved)."
                    )
                    with recovery_deadline():
                        redeploy_detached(repo, restore, log_path)
                    write_deployed(repo, restore)
                    journal(
                        repo,
                        "adopt_failed",
                        stage="deploy",
                        candidate=tip,
                        rc=deploy_outcome.returncode,
                        **(
                            {"reason": deploy_outcome.timeout_reason}
                            if deploy_outcome.timed_out
                            else {}
                        ),
                    )
                    prod_behind_banner(repo, tip, restore)
                else:
                    # Bootstrap: there is no previously-deployed SHA to fall
                    # back to, so a rollback deploy would be theatre — it would
                    # re-run the same failing command on the same tree.
                    say(f"DEPLOY FAILED (exit {deploy_outcome.returncode}).")
                    journal(
                        repo,
                        "adopt_failed",
                        stage="deploy",
                        candidate=tip,
                        rc=deploy_outcome.returncode,
                        bootstrap=True,
                        **(
                            {"reason": deploy_outcome.timeout_reason}
                            if deploy_outcome.timed_out
                            else {}
                        ),
                    )
                    prod_unknown_banner(repo, tip)
                say(f"log: {log_path}")
                say(log_tail(log_path, 50))
                return 1
            write_deployed(repo, tip)

            # publish
            lock.set_phase("publishing", "adopt")
            release_remaining("publish")
            publish_started = time.monotonic()
            if remote_exists(repo.canonical):
                publish(repo, tip)
            set_last_green(repo, tip)
            publish_seconds = time.monotonic() - publish_started
            total_seconds = time.monotonic() - release_started
            timings = {
                "queue_seconds": round(lock.queue_seconds, 6),
                "check_seconds": round(check_seconds, 6),
                "deploy_seconds": round(deploy_seconds, 6),
                "publish_seconds": round(publish_seconds, 6),
                "total_seconds": round(total_seconds, 6),
            }
            journal(
                repo, "complete", merged=tip, adopt=True, branch="adopt", **timings
            )
            if total_seconds > RELEASE_TARGET_SECONDS:
                lock.require_optimization_after_release(
                    "adopt", tip, total_seconds, log_path
                )

            say("")
            say("ADOPTED")
            say(f"  merged   : {short(repo.canonical, tip)} (main tip, gated in place)")
            say("  deployed : ok")
            say(
                "  timings  : "
                f"queue={timings['queue_seconds']:.3f}s "
                f"check={timings['check_seconds']:.3f}s "
                f"deploy={timings['deploy_seconds']:.3f}s "
                f"publish={timings['publish_seconds']:.3f}s "
                f"total={timings['total_seconds']:.3f}s"
            )
            say(f"  log      : {log_path}")
            return 0
        except ReleaseDeadlineExceeded as exc:
            rollback_error = None
            if deployed_before and deployed_before != tip:
                try:
                    with recovery_deadline():
                        redeploy_detached(repo, deployed_before, log_path)
                        write_deployed(repo, deployed_before)
                except Exception as rollback_exc:  # noqa: BLE001
                    rollback_error = repr(rollback_exc)
            journal(
                repo,
                "adopt_failed",
                stage="release_deadline",
                candidate=tip,
                reason=str(exc),
                **({"rollback_error": rollback_error} if rollback_error else {}),
            )
            say(f"RELEASE DEADLINE FAILED — {exc}")
            say(
                "release failed; recovery ran separately and is not a release success"
            )
            if rollback_error:
                say(f"ROLLBACK FAILED — {rollback_error}")
            return 1
        except SystemExit:
            raise
        except Exception as exc:  # noqa: BLE001
            journal(repo, "error", exc=repr(exc), branch="adopt")
            raise
        finally:
            lock.clear_status()


def cmd_done(args) -> int:
    repo = load_repo(args.repo)
    main = repo.main_branch
    start = Path(args.repo).resolve() if args.repo else Path.cwd()
    branch = current_branch(start)
    if branch in (main, "HEAD"):
        die("not on a greenline feature branch")
    wt = worktree_for_branch(repo.canonical, branch)
    if wt is None:
        die(f"no worktree found for branch {branch}")
    if worktree_is_dirty(wt) and not args.force:
        die(f"worktree {wt} is dirty — commit/stash or pass --force")

    last_green = rev(repo.canonical, LAST_GREEN_REF)
    verified = False
    if last_green:
        # squash-merge breaks ancestry; verify the branch's net diff is in last-green
        files = git_out(
            repo.canonical,
            "diff",
            "--name-only",
            git_out(repo.canonical, "merge-base", branch, last_green),
            branch,
        )
        if files.strip():
            dp = git(
                repo.canonical,
                "diff",
                "--quiet",
                branch,
                last_green,
                "--",
                *files.split("\n"),
                check=False,
            )
            verified = dp.returncode == 0
    if not verified and not args.force:
        die(
            f"cannot verify branch {branch} was merged into last-green.\n"
            "If you are sure it merged, re-run with --force.",
            1,
        )

    git(
        repo.canonical, "worktree", "remove", "--force" if args.force else "--", str(wt)
    )
    git(repo.canonical, "branch", "-D", branch)
    say(f"removed worktree {wt} and branch {branch}")
    return 0


def cmd_deploy_pending(args) -> int:
    """Recover a legacy or interrupted main lacking deploy attestation."""
    repo = load_repo(args.repo)
    pending = read_pending_deploy(repo)
    if not pending:
        say("nothing pending — deployed matches main")
        return 0
    log_path = repo.logs_dir / f"{utcnow()}-deploy-pending.log"
    lock = GateLock(repo)
    with lock:
        try:
            lock.set_phase("deploying-pending", "(deferred)")
            tip = rev(repo.canonical, repo.main_branch)
            say(f"deploying deferred main {short(repo.canonical, tip)} ...")
            outcome = deploy_now(repo, tip, log_path)
            if outcome.returncode != 0 or outcome.timed_out:
                journal(
                    repo,
                    "pending_deploy_failed",
                    pending=pending,
                    tip=tip,
                    rc=outcome.returncode,
                    **({"reason": outcome.timeout_reason} if outcome.timed_out else {}),
                )
                if outcome.timed_out:
                    say(f"DEPLOY TIMED OUT — {outcome.timeout_reason}.")
                say(f"DEPLOY FAILED (exit {outcome.returncode}). log: {log_path}")
                say(log_tail(log_path, 50))
                return 1
            settle_green(repo, tip)
            journal(repo, "pending_deployed", tip=tip)
            say(f"deployed {short(repo.canonical, tip)}")
            return 0
        finally:
            lock.clear_status()


def cmd_status(args) -> int:
    repo = load_repo(args.repo)
    canon = repo.canonical
    main = repo.main_branch
    held = lock_is_held(repo)
    say(f"repo     : {canon}")
    say(f"lock     : {'HELD' if held else 'free'}")
    st = read_json(repo.status_path)
    if st:
        pid = st.get("pid")
        alive = pid_alive(pid) if isinstance(pid, int) else False
        say(
            f"  holder pid={pid} ({'alive' if alive else 'DEAD'}) "
            f"branch={st.get('branch')} phase={st.get('phase')} started={st.get('started_utc')}"
        )
    main_sha = short(canon, main)
    lg = short(canon, LAST_GREEN_REF)
    dep = read_deployed(repo)
    dep_s = short(canon, dep) if dep else "-"
    origin_s = "-"
    if remote_exists(canon):
        o = rev(canon, f"origin/{main}")
        origin_s = short(canon, o) if o else "-"
    pending = read_pending_deploy(repo)
    if pending:
        verdict = "DEPLOY UNATTESTED"
    elif main_sha == lg == dep_s:
        verdict = "OK"
    else:
        verdict = "DRIFT"
    say(
        f"shas     : main={main_sha} origin={origin_s} last-green={lg} deployed={dep_s}  [{verdict}]"
    )
    if pending:
        say(
            f"pending  : {short(canon, pending)} gated but not deployed"
            " (`greenline deploy-pending` must recover it)"
        )

    entries = journal_entries(repo)
    if entries:
        say("journal  :")
        for e in entries[-3:]:
            extra = {k: v for k, v in e.items() if k not in ("event", "ts")}
            say(f"  {e.get('ts', '')} {e.get('event')} {extra}")
    gate = repo.gate_path
    gate_state = "missing"
    if gate.exists() and is_git_repo(gate):
        gate_state = "clean" if not worktree_is_dirty(gate) else "DIRTY"
    say(f"gate     : {gate} [{gate_state}]")
    logs = sorted(repo.logs_dir.glob("*.log")) if repo.logs_dir.exists() else []
    say(f"last log : {logs[-1] if logs else '-'}")
    return 0


def _doctor_report(repo: Repo) -> bool:
    canon = repo.canonical
    main = repo.main_branch
    ok = True

    def check(label: str, good: bool, detail: str = "") -> None:
        nonlocal ok
        mark = "ok " if good else "FAIL"
        if not good:
            ok = False
        say(f"  [{mark}] {label}{(' — ' + detail) if detail else ''}")

    check("greenline.toml present", (canon / "greenline.toml").exists())
    cv = repo.config.get("contract_version")
    check("contract_version == 1", cv == CONTRACT_VERSION, f"got {cv}")
    check("canonical clean", not worktree_is_dirty(canon))
    on_main = current_branch(canon) == main
    check(f"canonical on {main}", on_main)
    main_sha = rev(canon, main)
    lg = rev(canon, LAST_GREEN_REF)
    dep = read_deployed(repo)
    check(
        "main == last-green",
        bool(main_sha) and main_sha == lg,
        f"main={short(canon, main)} lg={short(canon, LAST_GREEN_REF)}",
    )
    pending = read_pending_deploy(repo)
    if pending:
        check(
            "no unattested deploy",
            False,
            f"main={short(canon, main)} deployed={short(canon, dep) if dep else '-'}; "
            "run `greenline deploy-pending`",
        )
    elif dep:
        check(
            "main == deployed",
            main_sha == dep,
            f"main={short(canon, main)} deployed={short(canon, dep)}",
        )
    gate_ok = repo.gate_path.exists() and is_git_repo(repo.gate_path)
    check("gate worktree healthy", gate_ok, str(repo.gate_path))
    hooks_dir = repo.common_dir / "hooks"
    for hook_name in ("pre-push", "reference-transaction", "pre-commit"):
        hook = hooks_dir / hook_name
        hook_ok = hook.exists() and MARK_BEGIN in hook.read_text()
        check(f"{hook_name} hook installed", hook_ok)
    run_script = canon / "run"
    if run_script.exists() and run_script.is_file():
        txt = run_script.read_text()
        check("./run implements check", "check" in txt)
        check("./run implements deploy", "deploy" in txt)
    else:
        check("./run present", False, "no run script")
    inc = last_incomplete_gate(repo)
    check("no incomplete gate in journal", inc is None)
    return ok


def cmd_doctor(args) -> int:
    repo = load_repo(args.repo)
    if args.fix:
        log_path = repo.logs_dir / f"{utcnow()}-doctor.log"
        with GateLock(repo):
            preflight_reconcile(repo, log_path)
        say("doctor --fix: preflight reconcile complete")
    say("greenline doctor:")
    ok = _doctor_report(repo)
    return 0 if ok else 2


