#!/bin/bash
# greenline ./run — house dispatch facade. Gate contract is check/deploy/health.
# lint and test are the local pieces check composes. Deploy does not restart
# any gate or daemon: this repo is a CLI skill, not a supervised service.
# The complete release targets 180s and is hard-bounded at 600s. This repository's
# check is change-impact validation: every test these files can break, not an
# exhaustive product suite that grows without bound.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

PY=(python3)

lint() {
    echo "==> lint"
    "${PY[@]}" -m py_compile greenline greenline-speedup
    ruff check --line-length 120 tests greenline greenline-speedup
    echo "==> lint passed"
}

pytest_run() {
    # Doctrine: tests are isolated (per-test tmp repos, OS-assigned ports), so run
    # them wide. xdist spreads individual tests across all cores (--dist load —
    # test_greenline.py holds most of the suite, so per-file grouping would
    # re-serialize it). Fall back to serial only if xdist is not installed.
    if "${PY[@]}" -c "import xdist" 2>/dev/null; then
        "${PY[@]}" -m pytest -x -q -n auto --dist load "$@"
    else
        "${PY[@]}" -m pytest -x -q "$@"
    fi
}

test_all() {
    echo "==> test"
    if [ "$#" -gt 0 ]; then
        pytest_run "$@"
        echo "==> test passed"
        return
    fi
    # Change-impact selection: run every test this candidate could break, and
    # only those. The selector fails closed (unknown path -> whole suite), so
    # product growth cannot silently escape validation OR inflate release time.
    local targets
    if ! targets="$("${PY[@]}" "$ROOT/scripts/impact_select.py")"; then
        echo "==> test: impact selection unavailable — running the whole suite"
        targets="$(ls tests/test_*.py)"
    fi
    if [ -z "$targets" ]; then
        echo "==> test: candidate touches no tested behaviour — nothing to run"
        echo "==> test passed"
        return
    fi
    echo "==> test: selected by change impact:"
    echo "$targets" | sed 's/^/      /'
    # shellcheck disable=SC2086
    pytest_run $targets
    echo "==> test passed"
}

check() {
    echo "==> check"
    lint
    test_all
    echo "==> check passed"
}

health() {
    echo "==> health"
    test -x "$ROOT/greenline"
    test -x "$ROOT/greenline-speedup"
    "${PY[@]}" -m py_compile "$ROOT/greenline" "$ROOT/greenline-speedup"
    "$ROOT/greenline" -h >/dev/null
    "$ROOT/greenline-speedup" -h >/dev/null
    echo "==> health passed"
}

deploy() {
    echo "==> deploy: CLI skill has no runtime; idempotent no-op"
    health
}

case "${1:-}" in
    lint) shift; lint "$@" ;;
    test) shift; test_all "$@" ;;
    check) shift; check "$@" ;;
    health) shift; health "$@" ;;
    deploy) shift; deploy "$@" ;;
    *)
        echo "usage: ./run {check|lint|test|health|deploy}" >&2
        exit 2
        ;;
esac
